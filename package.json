{
  "name": "hikari-site",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "bun scripts/fetch-downloads.ts --offline && vite dev",
    "build": "bun scripts/fetch-downloads.ts && vite build && bun scripts/postbuild.ts",
    "preview": "wrangler dev --port 8787",
    "typecheck": "bun scripts/fetch-downloads.ts --offline && tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "check-links": "bun scripts/check-links.ts",
    "test:e2e": "playwright test",
    "downloads": "bun scripts/fetch-downloads.ts",
    "test": "bun test src",
    "stills": "VITE_SHOW_DRAFTS=1 bun run build && bun scripts/render-stills.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-thai": "5.3.0",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "@tanstack/start-static-server-functions": "1.167.43",
    "akarisub": "1.1.6",
    "fumadocs-core": "16.17.8",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.8",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.4",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "nitro": "3.0.260903-beta",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wrangler": "4.153.0"
  }
}
