{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "hikari-ingest",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  // HikariSub's usage data endpoint: forwards POST /batch/ and /i/v0/e/ to eu.i.posthog.com.
  // Served on i.hikarisub.org (orange cloud, so no tracker CNAME shows), and on workers.dev for checks.
  "routes": [{ "pattern": "i.hikarisub.org", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false,
  // No logs: the Worker must not keep request bodies or IPs anywhere.
  "observability": { "enabled": false, "logs": { "enabled": false } },
  "logpush": false
}
